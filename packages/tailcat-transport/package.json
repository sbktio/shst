{
  "name": "@shst/tailcat-transport",
  "version": "0.0.0",
  "private": true,
  "description": "Peer-to-peer whiteboard transport over Tailcat, with a WebRTC direct-path upgrade. The Go wrapper builds to wasm.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "node --test 'test/**/*.test.ts'",
    "test:go": "cd qbtailcat && go test .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shst/whiteboard": "workspace:*"
  },
  "devDependencies": {
    "@shst/tsconfig": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
