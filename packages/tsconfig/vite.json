{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Browser code that Vite serves and bundles: bundler resolution and the DOM.
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  }
}
