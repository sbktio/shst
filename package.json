{
  "name": "shst",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "pnpmTarballUrlPolicy": {
    "rules": [
      {
        "registry": "https://packagefeedproxy.microsoft.io/npm/",
        "includeTarballHostSuffixes": [
          "pkgs.visualstudio.com"
        ],
        "action": "omit"
      }
    ]
  },
  "scripts": {
    "build": "pnpm run build:wasm && turbo run build",
    "build:wasm": "turbo run build:wasm --filter=@shst/tailcat-transport",
    "demo:build": "node scripts/whiteboard-demo.mjs build",
    "demo:start": "node scripts/whiteboard-demo.mjs start",
    "demo:status": "node scripts/whiteboard-demo.mjs status",
    "demo:stop": "node scripts/whiteboard-demo.mjs stop",
    "dev": "pnpm run build:wasm && turbo run dev --filter=@shst/whiteboard-app",
    "lockfile:check": "node apply-pnpm-tarball-policy.mjs --check",
    "lockfile:repair": "node apply-pnpm-tarball-policy.mjs && pnpm install --lockfile-only",
    "preview": "pnpm run build && turbo run preview --filter=@shst/whiteboard-app",
    "tailcat:check": "node scripts/check-tailcat-pin.mjs",
    "test": "turbo run test",
    "test:go": "turbo run test:go",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm run lockfile:check && pnpm run tailcat:check && turbo run typecheck test test:go && pnpm run build"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
